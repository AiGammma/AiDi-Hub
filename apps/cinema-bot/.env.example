# Telegram: create a bot with @BotFather and paste the token
CINEBOT_TELEGRAM_TOKEN=

# TMDB: register at themoviedb.org -> Settings -> API. Either the v3 "API Key"
# or the v4 "API Read Access Token" works.
CINEBOT_TMDB_API_KEY=
CINEBOT_TMDB_LANGUAGE=ru-RU
# If api.themoviedb.org is unreachable from your network, host the bot abroad
# or point this at a mirror/proxy you control.
CINEBOT_TMDB_BASE_URL=https://api.themoviedb.org/3

# Claude (optional). Without a key the bot still works with rule-based ranking.
ANTHROPIC_API_KEY=
CINEBOT_ANTHROPIC_MODEL=claude-opus-5-5
CINEBOT_LLM_EFFORT=medium

# Storage. SQLite for now; Postgres later: postgresql+asyncpg://user:pass@host/db
CINEBOT_DATABASE_URL=sqlite+aiosqlite:///./cinebot.db

# Comma-separated Telegram user ids with unlimited access (yours)
CINEBOT_OWNER_TELEGRAM_IDS=

# --- Monetization (built in, switched off) ---
# false: everyone gets unlimited use, usage is still recorded.
CINEBOT_MONETIZATION_ENABLED=false

# --- Taste data export (built in, no-op until users opt in) ---
# Secret salt used to pseudonymize user ids in exports. Rotate to unlink datasets.
CINEBOT_EXPORT_SALT=
CINEBOT_EXPORT_MIN_GROUP_SIZE=5
CINEBOT_EXPORT_MIN_RATINGS=20
